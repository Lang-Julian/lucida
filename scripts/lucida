#!/usr/bin/env bash
# Open Lucida on a project folder: `lucida .` or `lucida ~/code/some-repo`.
# That folder's board lives in <folder>/.lucida/board.excalidraw, and Lucida
# reads its AGENTS.md / CLAUDE.md the way a coding agent would.
set -euo pipefail
target="${1:-.}"
if [[ ! -d "$target" ]]; then
  echo "lucida: $target is not a folder" >&2
  exit 1
fi
exec open -na "/Applications/Lucida.app" --args "$(cd "$target" && pwd)"
